# Copy to .env.local (never committed). Both values are read on the server only;
# they are deliberately NOT prefixed with NEXT_PUBLIC_, so they never reach the browser.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase anon (public) key. Row-level security and the RPC role checks protect the data.
# Never put the service-role key here or anywhere in this app.
SUPABASE_ANON_KEY=

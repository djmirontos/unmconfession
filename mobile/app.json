{
  "expo": {
    "name": "UNM Freedom Confessions",
    "slug": "unm-freedom-confessions",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "unmconfessions",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0B",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.unmfreedom.confessions"
    },
    "android": {
      "package": "com.unmfreedom.confessions",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon-foreground.png",
        "backgroundColor": "#03224B"
      },
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to use photos you choose for your posts and listings.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to take photos for your posts and listings.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/notification-icon.png",
          "color": "#4F46E5",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/branding/splash-icon.png",
            "backgroundColor": "#0A0A0B"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b17408f-27a2-4023-a20b-e0c906568565"
      }
    },
    "owner": "daryljm",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2b17408f-27a2-4023-a20b-e0c906568565"
    }
  }
}

{
  "expo": {
    "name": "UNM Freedom Confessions",
    "slug": "unm-freedom-confessions",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "unmconfessions",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0B",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.unmfreedom.confessions"
    },
    "android": {
      "package": "com.unmfreedom.confessions",
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to use photos you choose for your posts and listings.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to take photos for your posts and listings.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
